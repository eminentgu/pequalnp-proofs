theorem allOK (i : Nat) (hi : i < 106) : nodeOK table i = true := by
  by_cases h_0 : i < 12
  · exact span_ok c_0 i (by omega) (by omega)
  by_cases h_12 : i < 24
  · exact span_ok c_12 i (by omega) (by omega)
  by_cases h_24 : i < 36
