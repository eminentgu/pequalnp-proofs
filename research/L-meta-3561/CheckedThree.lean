def hash (salt : Nat) (v : List Wire) (k t : Nat) : Nat :=
  (v.foldl (fun s w =>
    let x := ((w.1.1 % 1048573)*(65537+salt) + (w.1.2 % 1048573)*131 + 317) % 1048573
    s + ((x*x % 1048573)*x % 1048573)) (75*k + 263*t)) % 1048573
def shiftsData : Nat → Nat
  | 0 => 
  | 1 => 
  | _ => 0
def shifts (i : Nat) : Nat := ((shiftsData (i/256)) >>> (5*(i%256))) &&& 0x1f
def indicesData : Nat → Nat
  | 0 => 
  | 1 => 
  | 2 => 
  | 3 => 
  | 4 => 
  | 5 => 
  | 6 => 
  | 7 => 
  | _ => 0
def indices (i : Nat) : Nat := ((indicesData (i/256)) >>> (8*(i%256))) &&& 0xff
def witnessesData : Nat → Nat
  | 0 => 
  | _ => 0
def witnesses (i : Nat) : Nat := ((witnessesData (i/256)) >>> (56*(i%256))) &&& 0xffffffffffffff
def nodesData : Nat → Nat
  | 0 => 
  | 1 => 
  | _ => 0
def nodes (i : Nat) : Nat := ((nodesData (i/64)) >>> (61*(i%64))) &&& 0x1fffffffffffffff
def positiveData : Nat → Nat
  | 0 => 
  | 1 => 
  | _ => 0
def positive (i : Nat) : Nat := ((positiveData (i/12)) >>> (414*(i%12))) &&& 0x3fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
def negativeData : Nat → Nat
  | 0 => 
  | 1 => 
  | _ => 0
def negative (i : Nat) : Nat := ((negativeData (i/12)) >>> (414*(i%12))) &&& 0x3fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
def hint (k t : Nat) (v : List Wire) : Nat :=
  let lane := (hash 13 v k t) % 512
  let slot := ((hash 49 v k t) + shifts lane) % 2048
  witnesses (indices slot)
def unpack : Nat → Nat → List Wire
  | 0,_ => []
  | n+1,z => let i := z &&& 31; ((positive i,negative i),.tNone) :: unpack n (z >>> 5)
def node (i : Nat) : Node :=
  let z := nodes i
  ⟨z &&& 15,(z >>> 4) &&& 7,unpack ((z >>> 7) &&& 15) (z >>> 11)⟩
def table : Table := ⟨106,hint,node⟩
end PEqualNP.Research3561.Memo3
