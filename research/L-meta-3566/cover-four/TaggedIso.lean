import PackedIso
import Tagged292
import Canonical186

namespace VertexPeel.Mask4
open VertexPeel.CoverFourClass
set_option maxRecDepth 100000
set_option maxHeartbeats 0

open Packed

private structure Witness where
  source : Code
  row : Fin 186
  forward : ℕ
  backward : ℕ

private def check (w : Witness) : Bool :=
  decide (w.source = canonicalCode w.row ∨ Valid w.source (canonicalCode w.row) w.forward w.backward)

private theorem sound {w : Witness} (ok : check w = true) :
    Nonempty (graph w.source ≃g graph (canonicalCode w.row)) := by
  rcases (of_decide_eq_true ok : w.source = canonicalCode w.row ∨ _) with same | valid
  · rw [same]
    exact ⟨RelIso.refl _⟩
  · exact ⟨isoOfValid valid⟩

