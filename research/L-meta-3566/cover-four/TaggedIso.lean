private theorem named : witnesses.map Witness.source = tagged292 := by decide +kernel
private theorem allChecked : witnesses.all check = true := by decide +kernel

/-- A tagged minimum cover presentation can be relabelled as one of the 186
    graphs. The permutation may move vertices across the distinguished cover. -/
theorem tagged_to_canonical {z : Code} (hz : z ∈ tagged292) :
    ∃ i : Fin 186, Nonempty (graph z ≃g graph (canonicalCode i)) := by
  rw [← named] at hz
  obtain ⟨w,mem,rfl⟩ := List.mem_map.mp hz
  exact ⟨w.row,sound (List.all_eq_true.mp allChecked w mem)⟩

end VertexPeel.Mask4
#print axioms VertexPeel.Mask4.tagged_to_canonical
