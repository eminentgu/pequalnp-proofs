def marked (z : Code) (bits : Nat) : Finset (Fin (4 + (columns z).length)) :=
  Finset.univ.filter fun i => bits.testBit i.val

def validCover (p : Code × Nat) : Bool :=
  decide ((marked p.1 p.2).card ≤ 3 ∧ ∀ a b, (graph p.1).Adj a b →
    a ∈ marked p.1 p.2 ∨ b ∈ marked p.1 p.2)

theorem checked : supers.all validCover = true := by decide +kernel

/-- A zero reference retains the code. A nonzero reference can discard a code
only after its bits are verified to be a subset of the selected cover-three graph. -/
def trim : List Code → List Nat → List Code
  | [], _ => []
  | a::xs, [] => a::xs
  | a::xs, k::ks => if k ≠ 0 ∧ ((supers.getD k (0,0)).1 &&& a) = a
      then trim xs ks else a :: trim xs ks

