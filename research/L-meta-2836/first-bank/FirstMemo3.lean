def negative (i : Nat) : Nat := ((negativeData (i/12)) >>> (414*(i%12))) &&& 0x3fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
def hint (k t : Nat) (v : List Wire) : Nat :=
  let lane := (hash 7 v k t) % 512
  let slot := ((hash 43 v k t) + shifts lane) % 2048
  witnesses (indices slot)
def unpack : Nat → Nat → List Wire
  | 0,_ => []
  | n+1,z => let i := z &&& 31; ((positive i,negative i),.tNone) :: unpack n (z >>> 5)
def node (i : Nat) : Node :=
  let z := nodes i
  ⟨z &&& 15,(z >>> 4) &&& 7,unpack ((z >>> 7) &&& 15) (z >>> 11)⟩
def table : Table := ⟨106,hint,node⟩
